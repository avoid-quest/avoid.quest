{
	"root": false,
	"$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.d.ts",
			"!**/convex/_generated/*",
			"!**/_generated/**/*.ts",
			"!**/_generated/**/*.js"
		]
	},
	"linter": {
		"rules": {
			"style": {
				"useFilenamingConvention": "off"
			}
		}
	}
}
