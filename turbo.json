{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "out/**", "dist/**"]
    },
    "fix": {
      "cache": false,
      "dependsOn": ["^fix"]
    },
    "check": {
      "cache": false,
      "dependsOn": ["^check"]
    },
    "typecheck": {
      "cache": false,
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:setup": {
      "cache": false,
      "persistent": true
    },
    "cf-build": {
      "cache": false,
      "dependsOn": ["^cf-build"]
    },
    "cf-deploy": {
      "cache": false,
      "dependsOn": ["^cf-deploy"]
    },
    "cf-upload": {
      "cache": false,
      "dependsOn": ["^cf-upload"]
    },
    "cf-typegen": {
      "cache": false,
      "dependsOn": ["^cf-typegen"]
    },
    "test": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "preview": {
      "cache": false,
      "dependsOn": ["^preview"],
      "persistent": true
    }
  }
}
