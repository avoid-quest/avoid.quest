{
		"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-11-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	}
}
