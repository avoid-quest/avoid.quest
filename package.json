{
  "name": "avoid.quest",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.4",
      "react-dom": "^19.2.4",
      "next-themes": "^0.4.6",
      "zod": "^4.3.6",
      "convex": "^1.32.0",
      "sonner": "^2.0.7",
      "lucide-react": "^0.575.0",
      "tailwindcss": "^4.2.0",
      "@tailwindcss/postcss": "^4.2.0",
      "@tailwindcss/vite": "^4.2.0",
      "typescript": "^5.9.3",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^22.19.11",
      "@types/bun": "latest",
      "@cloudflare/workers-types": "^4.20260302.0",
      "wrangler": "^4.67.0",
      "vite": "^7.3.1",
      "vitest": "^4.0.18",
      "@vitejs/plugin-react": "^5.1.4"
    }
  },
  "scripts": {
    "cf-build": "turbo cf-build",
    "cf-deploy": "turbo cf-deploy",
    "cf-upload": "turbo cf-upload",
    "cf-typegen": "turbo cf-typegen",
    "ui": "bun --filter @avoid.quest/ui ui",
