---
import GitHubIcon from "@avoid.quest/ui/components/github-icon";
import AvoidLogo from "@avoid.quest/ui/components/avoid-logo";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";
export const prerender = true;
---

<Layout>
  <div class="flex h-full flex-col items-center justify-center px-6 text-center">
    <AvoidLogo className="-mb-10 size-64" />
    <small class="font-mono text-muted-foreground text-xs"> avoid.quest </small>

    <div class="mt-10 flex w-full max-w-2xl flex-col items-center gap-4 sm:gap-3">
      <a
        href="https://radio.avoid.quest"
        target="_blank"
        rel="noopener"
        data-umami-event="homepage-link-click"
        data-umami-event-destination="radio"
        class="group inline-flex items-baseline justify-center gap-1.5 px-2 py-1 text-sm sm:text-[0.95rem]"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">radio</span>
        <span class="text-muted-foreground">— enhanced web player</span>
      </a>

      <a
        href="https://couch.avoid.quest"
        target="_blank"
        rel="noopener"
        data-umami-event="homepage-link-click"
        data-umami-event-destination="couch"
        class="group inline-flex items-baseline justify-center gap-1.5 px-2 py-1 text-sm sm:text-[0.95rem]"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">couch</span>
        <span class="text-muted-foreground">— multiplayer media center</span>
      </a>

      <a
        href="https://feed.avoid.quest"
        target="_blank"
        rel="noopener"
        data-umami-event="homepage-link-click"
        data-umami-event-destination="feed"
        class="group inline-flex items-baseline justify-center gap-1.5 px-2 py-1 text-sm sm:text-[0.95rem]"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">feed</span>
        <span class="text-muted-foreground">— stay informed</span>
      </a>

      <a
        href="https://cwavasape.com"
        target="_blank"
        rel="noopener"
        data-umami-event="homepage-link-click"
        data-umami-event-destination="cwavasape"
        class="group inline-flex items-baseline justify-center gap-1.5 px-2 py-1 text-sm sm:text-[0.95rem]"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">cwavasape</span>
        <span class="text-muted-foreground">— doomscroller internet gallery</span>
      </a>
    </div>
  </div>

  <footer slot="footer" class="flex min-h-16 w-full items-start gap-3 p-4">
    <details class="mr-auto min-w-0 max-w-xl flex-1 py-2 text-xs">
      <summary class="cursor-pointer rounded-sm text-muted-foreground outline-none hover:text-foreground focus:ring-[3px] focus:ring-ring/50">
        What I know about you
      </summary>
      <p class="mt-3 text-muted-foreground leading-relaxed">
        This page uses Umami to count visits and clicks on the four product
        links, with browser, language, screen and referrer data. Location and
        session estimates may reflect our analytics proxy. Umami does not store
        IP addresses. Page query strings and fragments are
        excluded; Umami respects Do Not Track. Your theme is saved in this
        browser. Services you contact can see your connection IP. The linked
        products have their own data practices.
      </p>
    </details>
    <a href="https://github.com/avoid-quest/avoid.quest" aria-label="avoid.quest on GitHub" class="inline-flex size-9 shrink-0 items-center justify-center rounded-md text-muted-foreground outline-none hover:bg-accent hover:text-accent-foreground focus-visible:ring-[3px] focus-visible:ring-ring/50">
      <GitHubIcon className="size-4" />
    </a>
    <ThemeToggle />
  </footer>
</Layout>
