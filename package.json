{
  "name": "my-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ui": "bun --filter @workspace/ui ui",
    "dev": "turbo dev",
    "build": "turbo build",
    "fix": "turbo fix",
    "check": "turbo check",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "cleanup": "rm -rf bun.lock .turbo node_modules apps/web/node_modules apps/web/.next packages/ui/node_modules"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/node": "^22.18.12",
    "tsdown": "^0.15.10",
    "turbo": "^2.5.8",
    "ultracite": "6.0.4"
  },
  "packageManager": "bun@1.3.1"
}
