{
  "name": "avoid.quest",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "!apps/openDAW",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "next": "^16.1.4",
      "next-themes": "^0.4.6",
      "zod": "^4.3.5",
      "convex": "^1.31.5",
      "sonner": "^2.0.7",
      "lucide-react": "^0.562.0",
      "tailwindcss": "^4.1.18",
      "@tailwindcss/postcss": "^4.1.18",
      "@tailwindcss/vite": "^4.1.18",
      "typescript": "^5.9.3",
      "@types/react": "^19.2.9",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^22.19.7",
      "@types/bun": "latest",
      "@cloudflare/workers-types": "^4.20260120.0",
      "wrangler": "^4.59.3",
      "vite": "^7.3.1",
      "vitest": "^4.0.17",
      "@vitejs/plugin-react": "^5.1.2"
    }
  },
  "scripts": {
    "instagram-adapter": "cd packages/instagram-adapter && bun run",
    "cf-build": "turbo cf-build",
    "cf-deploy": "turbo cf-deploy",
    "cf-upload": "turbo cf-upload",
    "cf-typegen": "turbo cf-typegen",
    "ui": "bun --filter @workspace/ui ui",
    "dev:backend": "turbo -F @workspace/backend dev",
    "dev:setup": "turbo -F @workspace/backend dev:setup",
    "deploy:backend": "turbo -F @workspace/backend deploy",
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "turbo typecheck",
    "preview": "turbo preview",
    "test": "turbo test",
    "cleanup": "rm -rf bun.lock .turbo node_modules apps/instarip/node_modules apps/instarip/.next apps/instarip/.open-next apps/web/node_modules apps/web/.next apps/web/.open-next apps/radio/node_modules apps/radio/.tanstack apps/radio/dist apps/radio/.wrangler packages/ui/node_modules packages/backend/node_modules packages/instagram-adapter/node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:instagram-adapter": "cd packages/instagram-adapter && bun run build:all && cd ../.. && bunx changeset tag && git push --follow-tags"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@changesets/cli": "^2.29.8",
    "@cloudflare/workers-types": "^4.20260120.0",
    "@types/bun": "^1.3.6",
    "@types/node": "^22.19.7",
    "tsdown": "^0.19.0",
    "turbo": "^2.7.5",
    "ultracite": "7.0.11"
  },
  "packageManager": "bun@1.3.6",
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
