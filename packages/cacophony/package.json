{
  "name": "@avoid.quest/cacophony",
  "version": "0.19.0",
  "description": "Typescript audio library with caching",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/avoid-quest/avoid.quest.git",
    "directory": "packages/cacophony"
  },
  "homepage": "https://github.com/avoid-quest/avoid.quest/tree/main/packages/cacophony",
  "author": "avoid.quest",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run typecheck && bun run clean && bun run build.ts",
    "build:lib": "bun run build.ts --lib",
    "build:worklets": "bun run build.ts --worklets",
    "dev": "bun --watch build.ts",
    "typecheck": "tsc --noEmit",
    "fix": "bunx ultracite fix",
    "check": "bunx ultracite check",
    "clean": "rimraf dist",
    "test": "bun test",
    "ci:test": "bun test"
  },
  "keywords": [
    "audio",
    "audio worklets",
    "synthesis",
    "webaudio"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.3",
    "@types/node": "^22.19.1",
    "@workspace/typescript-config": "workspace:*",
    "rimraf": "^6.1.2",
    "standardized-audio-context-mock": "^9.7.24",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opendaw/lib-dsp": "^0.0.50",
    "@opendaw/lib-std": "^0.0.50",
    "fft.js": "^4.0.4",
    "standardized-audio-context": "^25.3.77"
  }
}
