{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!**/*.astro",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/wrangler.jsonc",
      "!**/cloudflare-env.d.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["**/dsp/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "correctness": {
            "noUnusedPrivateClassMembers": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "globals": [
      "Bun",
      "AudioWorkletProcessor",
      "registerProcessor",
      "sampleRate",
      "__APP_VERSION__",
      "__SENTRY_RELEASE__",
      "__CHANGELOG_NEWEST_DATE__"
    ]
  },
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedImports": {
          "fix": "none",
          "level": "warn"
        }
      },
      "performance": {
        "noBarrelFile": "off"
      },
      "suspicious": {
        "noConsole": "off"
      },
      "nursery": {
        "useSortedClasses": "info"
      },
      "style": {
        "useConsistentTypeDefinitions": {
          "fix": "safe",
          "level": "info",
          "options": {
            "style": "type"
          }
        },
        "useBlockStatements": {
          "fix": "safe",
          "level": "info"
        }
      }
    }
  },
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/tanstack"
  ]
}
