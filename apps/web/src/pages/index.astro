---
import AvoidLogo from "@avoid.quest/ui/components/avoid-logo";
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";
export const prerender = true;
---

<Layout>
  <div class="flex h-full flex-col items-center justify-center px-6 text-center">
    <AvoidLogo className="-mb-10 size-64" />
    <small class="font-mono text-muted-foreground text-xs tracking-[0.08em]"> avoid.quest </small>

    <div class="mt-9 flex w-full max-w-2xl flex-col items-center gap-3">
      <a
        href="https://radio.avoid.quest"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-baseline gap-2 rounded-sm px-1 py-0.5 text-sm leading-none"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">radio</span>
        <span class="text-muted-foreground">enhanced web player</span>
      </a>

      <a
        href="https://feed.avoid.quest"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-baseline gap-2 rounded-sm px-1 py-0.5 text-sm leading-none"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">feed</span>
        <span class="text-muted-foreground">stay informed</span>
      </a>

      <a
        href="https://instarip.avoid.quest"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-baseline gap-2 rounded-sm px-1 py-0.5 text-sm leading-none"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">instarip</span>
        <span class="text-muted-foreground">escape the platform</span>
      </a>

      <a
        href="https://cwavasape.com"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-baseline gap-2 rounded-sm px-1 py-0.5 text-sm leading-none"
      >
        <span class="text-primary underline-offset-4 group-hover:underline">cwavasape</span>
        <span class="text-muted-foreground">doomscroller internet gallery</span>
      </a>
    </div>
  </div>

  <footer slot="footer" class="flex h-16 w-full items-center justify-end p-4">
    <ThemeToggle />
  </footer>
</Layout>
