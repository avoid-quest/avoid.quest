# Convex deployment URL (required)
# Get this from your Convex dashboard or run `bunx convex env list`
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex site URL for media proxy (required)
# This is typically: https://your-deployment.convex.site
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Allowed hosts for dev server (optional, comma-separated)
ALLOWED_HOSTS=localhost
