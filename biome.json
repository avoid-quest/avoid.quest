{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/dev-dist",
      "!**/.zed",
      "!**/.vscode",
      "!**/routeTree.gen.ts",
      "!**/src-tauri",
      "!**/.nuxt",
      "!bts.jsonc",
      "!**/.expo",
      "!**/.wrangler",
      "!**/.svelte-kit",
      "!**/wrangler.jsonc",
      "!**/.source",
      "!**/cloudflare-env.d.ts",
      "!**/*-bundle.js",
      "!**/*-bundle.d.ts",
      "!**/packages/cacophony/src"
    ]
  },
  "javascript": {
    "globals": [
      "Bun",
      "AudioWorkletProcessor",
      "AudioWorkletNodeOptions",
      "AudioParam",
      "MessagePort",
      "AutomationRate",
      "registerProcessor",
      "sampleRate",
      "BUFFER_SIZE"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        "noImgElement": "off"
      },
      "suspicious": {
        "noConsole": "off"
      },
      "nursery": {
        "useSortedClasses": "info"
      }
    }
  },
  "extends": [
    "ultracite/core",
    "ultracite/next",
    "ultracite/remix",
    "ultracite/react"
  ]
}
