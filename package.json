{
  "name": "avoid.quest",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "next-themes": "^0.4.6",
      "zod": "^4.4.3",
      "convex": "^1.38.0",
      "sonner": "^2.0.7",
      "lucide-react": "^1.14.0",
      "tailwindcss": "^4.3.0",
      "@tailwindcss/vite": "^4.3.0",
      "typescript": "^6.0.3",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^25.6.2",
      "@types/bun": "latest",
      "@cloudflare/workers-types": "^4.20260510.1",
      "wrangler": "^4.90.0",
      "vite": "^8.0.11",
      "vitest": "^4.1.5",
      "@vitejs/plugin-react": "^6.0.1"
    }
  },
  "scripts": {
    "cf-build": "turbo cf-build",
    "cf-deploy": "turbo cf-deploy",
    "cf-upload": "turbo cf-upload",
    "cf-typegen": "turbo cf-typegen",
    "ui": "bun --filter @avoid.quest/ui ui",
    "dev:backend": "turbo -F @avoid.quest/backend dev",
    "dev:setup": "turbo -F @avoid.quest/backend dev:setup",
    "deploy:backend": "turbo -F @avoid.quest/backend deploy",
    "sandcastle": "bun run .sandcastle/main.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "typecheck": "turbo typecheck",
    "preview": "turbo preview",
    "test": "turbo test",
    "cleanup": "./scripts/cleanup.sh",
    "radio:diagnostics": "bash ./scripts/radio-stream-diagnostics.sh",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.5.10",
    "@biomejs/biome": "2.4.15",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.2",
    "turbo": "^2.9.12",
    "ultracite": "7.6.5"
  },
  "packageManager": "bun@1.3.13",
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
