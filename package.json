{
  "name": "avoid.quest",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.2.6",
      "react-dom": "^19.2.6",
      "next-themes": "^0.4.6",
      "zod": "^4.4.3",
      "sonner": "^2.0.7",
      "lucide-react": "^1.16.0",
      "tailwindcss": "^4.3.0",
      "@tailwindcss/vite": "^4.3.0",
      "typescript": "^6.0.3",
      "@types/react": "^19.2.15",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^25.9.1",
      "@types/bun": "latest",
      "@cloudflare/workers-types": "^4.20260523.1",
      "wrangler": "^4.94.0",
      "vite": "^8.0.14",
      "@vitejs/plugin-react": "^6.0.2"
    }
  },
  "scripts": {
    "cf-build": "turbo cf-build",
