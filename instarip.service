[Unit]
Description=Instarip Cron Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/avoid.quest
ExecStart=/home/avoid.quest/packages/instagram-adapter/out/instagram-adapter start
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Signal handling for graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
SendSIGKILL=yes

# Resource limits
MemoryMax=1024M
CPUQuota=50%

[Install]
WantedBy=multi-user.target

